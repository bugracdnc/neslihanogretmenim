---
import { categories } from "../data/categories";

const rawBase = import.meta.env.BASE_URL;
const baseUrl = rawBase.endsWith("/") ? rawBase.slice(0, -1) : rawBase;
---

<header
  class="w-full bg-white/80 backdrop-blur-md border-b border-slate-100 sticky top-0 z-50"
>
  <div class="max-w-6xl mx-auto px-4 h-20 flex items-center justify-between">
    <a
      href={`${baseUrl}/`}
      class="text-2xl font-black tracking-tight text-slate-800"
    >
      Neslihan <span class="text-pink-500">Öğretmenim</span>
    </a>
    <nav class="hidden md:flex gap-8 items-center">
      <div class="relative group">
        <button
          class="font-semibold text-slate-600 hover:text-pink-500 transition-colors flex items-center gap-1 py-8"
        >
          Etkinlikler
          <svg
            class="w-4 h-4 transition-transform group-hover:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <div
          class="absolute top-[80px] left-0 w-64 bg-white rounded-2xl shadow-xl border border-slate-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform translate-y-2 group-hover:translate-y-0 z-50 overflow-hidden"
        >
          <div class="py-2">
            {
              categories.map((cat) => (
                <a
                  href={`${baseUrl}/kategori/${cat.slug}`}
                  class="block px-5 py-3 text-sm font-medium text-slate-600 hover:bg-pink-50 hover:text-pink-600 transition-colors border-b border-slate-50 last:border-0"
                >
                  {cat.name}
                </a>
              ))
            }
          </div>
        </div>
      </div>
      <a
        href={`${baseUrl}/`}
        class="font-semibold text-slate-600 hover:text-pink-500 transition-colors"
        >Ana Sayfa</a
      >
    </nav>
  </div>
</header>
