---
import Layout from "../layouts/Layout.astro";
import { categories } from "../data/categories";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="Neslihan Öğretmen | Etkinlik Havuzu">
  <section class="text-center py-12 md:py-20">
    <h1
      class="text-4xl md:text-6xl font-extrabold text-slate-800 tracking-tight mb-6"
    >
      Sınıf İçi <span class="text-pink-500">Etkinlik Havuzu</span>
    </h1>
    <p class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto px-4">
      Oyunlar, çalışma kağıtları, pano tasarımları ve çok daha fazlası.
      İncelemek istediğiniz kategoriyi seçin!
    </p>
  </section>

  <section class="max-w-5xl mx-auto mt-4 pb-20">
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6 px-4 md:px-6">
      {
        categories.map((cat) => (
          <a
            href={`${baseUrl}/kategori/${cat.slug}`}
            class="group relative block aspect-square rounded-[2.5rem] overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300"
          >
            <img
              src={cat.image}
              alt={cat.name}
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />

            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/10 to-transparent" />

            <h2 class="absolute bottom-6 left-6 right-6 text-xl md:text-2xl font-bold text-white text-left leading-tight">
              {cat.name}
            </h2>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
